{
  "name": "giroke-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "simple-git-hooks",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build --quiet"
  },
  "dependencies": {
    "lucide-react": "1.71.0",
    "next": "16.4.5",
    "pretendard": "1.3.9",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@storybook/nextjs-vite": "10.6.7",
    "@tailwindcss/turbopack": "4.3.5",
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "jsdom": "31.0.0",
    "lint-staged": "17.6.0",
    "simple-git-hooks": "2.14.0",
    "storybook": "10.6.7",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "vite": "8.3.7",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged",
    "commit-msg": "npx --no -- commitlint --edit \"$1\""
  },
  "lint-staged": {
    "*.{js,jsx,mjs,cjs,ts,tsx,mts,cts}": "eslint --max-warnings=0"
  }
}
